<Project Sdk="Microsoft.NET.Sdk">

  <!-- One-off tool for Part B stage 2: it converts the seed's wire models to codec declarations, and Part B deletes it once they are converted. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- These land in the output folder, which supplies the references a converted project compiles against. -->
    <ProjectReference Include="..\..\Source\NexusTomorrow.Game.Static\NexusTomorrow.Game.Static.csproj" />
    <ProjectReference Include="..\..\Source\NexusTomorrow.Network\NexusTomorrow.Network.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NexusTomorrow.ModelConverter.Tests" />
  </ItemGroup>

</Project>
