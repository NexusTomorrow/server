<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The pages read each model project's documentation file, which a project reference copies beside this assembly. -->
    <ProjectReference Include="..\..\Source\NexusTomorrow.Network\NexusTomorrow.Network.csproj" />
    <ProjectReference Include="..\..\Source\NexusTomorrow.Network.Auth\NexusTomorrow.Network.Auth.csproj" />
    <ProjectReference Include="..\..\Source\NexusTomorrow.Network.World\NexusTomorrow.Network.World.csproj" />
    <!-- The opcode table and the command definitions, for their pages. -->
    <ProjectReference Include="..\..\Source\NexusTomorrow.Gateway\NexusTomorrow.Gateway.csproj" />
    <ProjectReference Include="..\..\Source\NexusTomorrow.Commands\NexusTomorrow.Commands.csproj" />
    <!-- The settings classes and their rules, for the host settings page; each project's documentation file holds its settings' summaries. -->
    <ProjectReference Include="..\..\Source\NexusTomorrow.Settings\NexusTomorrow.Settings.csproj" />
    <ProjectReference Include="..\..\Source\NexusTomorrow.Maps\NexusTomorrow.Maps.csproj" />
    <ProjectReference Include="..\..\Source\NexusTomorrow.Server\NexusTomorrow.Server.csproj" />
  </ItemGroup>

</Project>
