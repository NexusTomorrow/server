root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,xml,json,yml,yaml}]
indent_size = 2

[*.cs]
charset = utf-8-bom

# Layout
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = when_multiline:warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_diagnostic.IDE0011.severity = warning
dotnet_diagnostic.IDE0036.severity = warning
dotnet_diagnostic.IDE0040.severity = warning
dotnet_diagnostic.IDE0055.severity = warning
dotnet_diagnostic.IDE0065.severity = warning
dotnet_diagnostic.IDE0161.severity = warning

# Language
csharp_style_prefer_primary_constructors = false:suggestion
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_style_readonly_field = true:warning
csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true:warning
dotnet_style_collection_initializer = true:warning
dotnet_style_prefer_collection_expression = when_types_loosely_match:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_diagnostic.IDE0003.severity = warning
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = warning
dotnet_diagnostic.IDE0028.severity = warning
dotnet_diagnostic.IDE0041.severity = warning
dotnet_diagnostic.IDE0044.severity = warning
dotnet_diagnostic.IDE0049.severity = warning
dotnet_diagnostic.IDE0250.severity = warning
dotnet_diagnostic.IDE0251.severity = warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0305.severity = warning

# Classes are sealed unless built for inheritance; CA1852 covers internal types, review covers public ones
dotnet_diagnostic.CA1852.severity = warning
# CA1716 guards against keywords of other .NET languages, such as Visual Basic's Static, which names
# our Static namespaces; this codebase is C# only.
dotnet_diagnostic.CA1716.severity = none
# A [Flags] enum named ...Flags reads as what it is, as the BCL's BindingFlags does.
dotnet_code_quality.CA1711.allowed_suffixes = Flags

# Naming. Rules order themselves by specificity; a naming rule's own severity reaches only the IDE,
# so the build reads IDE1006's severity below.
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_rule.interfaces_take_i.symbols = interfaces
dotnet_naming_rule.interfaces_take_i.style = prefix_i
dotnet_naming_rule.interfaces_take_i.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_style.prefix_i.required_prefix = I
dotnet_naming_style.prefix_i.capitalization = pascal_case

# A const field is implicitly static, so the s_ rule below would claim it without this rule.
dotnet_naming_rule.constants_are_pascal.symbols = constants
dotnet_naming_rule.constants_are_pascal.style = pascal
dotnet_naming_rule.constants_are_pascal.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.static_fields_take_s.symbols = static_fields
dotnet_naming_rule.static_fields_take_s.style = prefix_s
dotnet_naming_rule.static_fields_take_s.severity = warning
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.applicable_accessibilities = private, internal, private_protected
dotnet_naming_symbols.static_fields.required_modifiers = static
dotnet_naming_style.prefix_s.required_prefix = s_
dotnet_naming_style.prefix_s.capitalization = camel_case

dotnet_naming_rule.instance_fields_take_underscore.symbols = instance_fields
dotnet_naming_rule.instance_fields_take_underscore.style = prefix_underscore
dotnet_naming_rule.instance_fields_take_underscore.severity = warning
dotnet_naming_symbols.instance_fields.applicable_kinds = field
dotnet_naming_symbols.instance_fields.applicable_accessibilities = private, internal, private_protected
dotnet_naming_style.prefix_underscore.required_prefix = _
dotnet_naming_style.prefix_underscore.capitalization = camel_case

# Data-shape code keeps the client's own names: its enum values (Neighbor_PlayerNotFound,
# FlightPathNew), its type names (GuildFlag, GuildRankPermission) and its value kinds (Integer, Float).
[{Source/NexusTomorrow.Game.Static/**.cs,Source/NexusTomorrow.GameTable/**.cs}]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1720.severity = none

# Table row models are field records the table loader fills by position (GameTable.cs:27 walks
# typeof(T).GetFields()), so their fields stay public fields.
[Source/NexusTomorrow.GameTable/Model/**.cs]
dotnet_diagnostic.CA1051.severity = none

# Win32 interop structs keep the API's names and field layout, which the marshaller reads.
[Source/NexusTomorrow.ClientConnector/Native/**.cs]
dotnet_diagnostic.CA1051.severity = none
dotnet_diagnostic.CA1707.severity = none

# Release tracking (RS2008) serves analyzers published as packages; this generator ships only inside
# the repository, built with the projects that use it.
[Source/NexusTomorrow.Network.Codec.Generator/**.cs]
dotnet_diagnostic.RS2008.severity = none

# Wire declarations carry the summaries their [Verified] rung requires, which the registry
# verification tests enforce; the opcode enum is a data declaration.
[{Source/NexusTomorrow.Network/Message/Model/**.cs,Source/NexusTomorrow.Network/Message/GameMessageOpcode.cs}]
dotnet_diagnostic.CS1591.severity = none

