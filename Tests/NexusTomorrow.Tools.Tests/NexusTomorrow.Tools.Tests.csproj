<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Tools\NexusTomorrow.Tools\NexusTomorrow.Tools.csproj" />
    <ProjectReference Include="..\NexusTomorrow.Testing\NexusTomorrow.Testing.csproj" />
  </ItemGroup>

  <!-- The tools exist only in Debug builds (NexusTomorrow.Tools.csproj), so their tests do too. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="**/*.cs" />
  </ItemGroup>

</Project>
