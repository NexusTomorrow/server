<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NexusTomorrow.Server.Tests" />
    <InternalsVisibleTo Include="NexusTomorrow.Harness" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexusTomorrow.Gateway\NexusTomorrow.Gateway.csproj" />
    <ProjectReference Include="..\NexusTomorrow.Maps\NexusTomorrow.Maps.csproj" />
    <ProjectReference Include="..\NexusTomorrow.Owners\NexusTomorrow.Owners.csproj" />
    <ProjectReference Include="..\NexusTomorrow.Persistence\NexusTomorrow.Persistence.csproj" />
    <ProjectReference Include="..\NexusTomorrow.Commands\NexusTomorrow.Commands.csproj" />
  </ItemGroup>

  <!-- In-process tooling, compiled into Debug builds only; CoreServices registers it under #if DEBUG. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\..\Tools\NexusTomorrow.Tools\NexusTomorrow.Tools.csproj" />
  </ItemGroup>

</Project>
