<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Wire declarations carry the summaries their [Verified] rung requires; the registry verification tests enforce that, so CS1591 does not. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexusTomorrow.Game.Static\NexusTomorrow.Game.Static.csproj" />
    <ProjectReference Include="..\NexusTomorrow.Network\NexusTomorrow.Network.csproj" />
    <ProjectReference Include="..\NexusTomorrow.Network.Codec.Generator\NexusTomorrow.Network.Codec.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
