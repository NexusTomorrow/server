<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Replaced in Part B: the declared models keep the seed's names and style until stage 3's last task brings them under the analyzers and removes these two lines. -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>10-none</AnalysisLevel>
    <!-- Replaced in Part B: the converted models keep the seed's widths, so an enum member wider than its field (NTC003) and an unsigned width on a narrow signed type (NTC006) stand until stage 3 settles each from the client facts. -->
    <NoWarn>$(NoWarn);NTC003;NTC006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexusTomorrow.Game.Static\NexusTomorrow.Game.Static.csproj" />
    <ProjectReference Include="..\NexusTomorrow.Network\NexusTomorrow.Network.csproj" />
    <ProjectReference Include="..\NexusTomorrow.Network.Codec.Generator\NexusTomorrow.Network.Codec.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
